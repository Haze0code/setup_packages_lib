# =============================================================================
#  ~/.config/git/config — réglages Git communs (déployé par setup-env)
#  L'identité (nom, e-mail, éditeur, branche) est dans ~/.gitconfig,
#  écrite par scripts/setup_git.sh. Git lit les deux fichiers.
# =============================================================================

[core]
    autocrlf = input
    pager = less -FRX
[color]
    ui = auto
[pull]
    rebase = false
[push]
    default = current
    autoSetupRemote = true
[fetch]
    prune = true
[diff]
    colorMoved = zebra
[merge]
    conflictStyle = diff3
[rerere]
    enabled = true

[alias]
    st = status -sb
    co = checkout
    sw = switch
    br = branch -vv
    ci = commit
    cm = commit -m
    amend = commit --amend --no-edit
    unstage = restore --staged
    last = log -1 HEAD --stat
    lg = log --graph --pretty=format:'%C(yellow)%h%C(reset) %s %C(green)(%cr)%C(reset) %C(blue)<%an>%C(reset)%C(auto)%d' --abbrev-commit
    tree = log --oneline --graph --decorate --all
